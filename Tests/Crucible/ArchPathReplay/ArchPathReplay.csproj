<Project Sdk="Microsoft.NET.Sdk">
  <!-- Replay the exact production geometry against the captured bad path;
       no native RB state or copied approximation participates in the test. -->
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework></PropertyGroup>
  <!-- RB scans .cs recursively; .cs.test fixtures compile only in this replay project. -->
  <ItemGroup><Compile Include="*.cs.test" /><Compile Include="../../../Dungeons/Crucible/ArchPathSafety.cs" Link="ArchPathSafety.cs" /></ItemGroup>
</Project>
