<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compile the production planner directly: replay assertions must exercise
       its actual timing/geometry rather than an independently copied algorithm. -->
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework></PropertyGroup>
  <!-- RB scans .cs recursively; .cs.test fixtures compile only in this replay project. -->
  <ItemGroup><Compile Include="*.cs.test" /><Compile Include="../../../Dungeons/Crucible/FireKitePlanner.cs" Link="FireKitePlanner.cs" /></ItemGroup>
</Project>
