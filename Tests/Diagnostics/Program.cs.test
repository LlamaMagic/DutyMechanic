using DutyMechanic.Helpers;

// Regression: Fireflight's 12.7s cast was absent from a hit summary 16.029s later.
// Also exercise mixed cast lifetimes: expiry is not ordered like cast discovery.
var t = new DateTime(2026, 10, 2, 13, 23, 55, DateTimeKind.Utc);
int checks = 0;
void Check(bool ok, string message) { if (!ok) throw new Exception(message); checks++; }
var h = new MechanicDiagnosticHistory<string>(3);
h.Add(t, MechanicDiagnosticHistory<string>.CastExpiry(t, 12.7), "45460");
Check(h.Snapshot(t.AddSeconds(16.029)).Single().Value == "45460", "Fireflight survives its delayed hit");
Check(h.Snapshot(t.AddSeconds(42.7)).Length == 1, "Evidence remains at inclusive expiry");
Check(h.Snapshot(t.AddSeconds(42.701)).Length == 0, "Expired evidence is removed");
h.Add(t, t.AddSeconds(100), "long");
h.Add(t.AddSeconds(1), t.AddSeconds(2), "short");
Check(h.Snapshot(t.AddSeconds(3)).Single().Value == "long", "Short cast expires behind long cast");
h.Add(t.AddSeconds(4), t.AddSeconds(100), "second");
h.Add(t.AddSeconds(5), t.AddSeconds(100), "third");
h.Add(t.AddSeconds(6), t.AddSeconds(100), "fourth");
Check(h.Count == 3 && h.Dropped == 1 && h.Snapshot(t.AddSeconds(6))[0].Value == "second", "Overflow is bounded and disclosed");
h.Clear();Check(h.Count == 0 && h.Dropped == 0,"Lifecycle reset clears evidence and overflow");
foreach (var seconds in new[]{double.NaN,double.PositiveInfinity,-5d})
 Check(MechanicDiagnosticHistory<string>.CastExpiry(t, seconds)==t.AddSeconds(30),"Invalid cast time is bounded");
Check(MechanicDiagnosticHistory<string>.CastExpiry(t,999)==t.AddSeconds(150),"Large duration is capped");
var movement=new MechanicDiagnosticHistory<string>(32);
for(int i=0;i<=100;i++) movement.Add(t.AddSeconds(i*.5),t.AddSeconds(i*.5+15),i.ToString());
Check(movement.Count==31 && movement.Dropped==0,"15-second half-second history remains bounded without overflow");
Check(movement.Snapshot(t.AddSeconds(66)).Length==0,"Movement expires without fresh samples");
var copy=h.Snapshot(t); h.Add(t,t.AddSeconds(30),"later");Check(copy.Length==0,"Snapshots are independent of subsequent writes");
Console.WriteLine($"PASS: {checks} diagnostic history regressions.");
